[Control]
initial_config = ./test.xyz
n_steps = 1000
engine = lammps
verbosity = 2
n_sessions = 7
engine_use_rank_0 = False
basin = True
#reference_table = ./reference_table.pickle
#visited_environments = ./visited_environments.pickle

[Lammps] 
pair_style = eam/alloy 
pair_coeff = * * ./Ni_v6_2.0_LKBeland2016.eam Ni
min_style = cg 
minimize = 1e-10 1e-12 10000 10000


[AtomicEnvironment] 
style = cna/graph
rnei = 3.0
rcut = 6.0

[EventSearch] 
style = partn
nsearch = 10
emax_event = 5.0
emin_event = 0.0

[pARTn] 
path_artnso = /root/programs/artn-plugin-1501/lib/libartn-lmp.so

[RateConstant] 
style = constant
k0 = 10
T = 300.0

[PSR] 
style = ira 
[IRA]

[BASIN]
energy_thr = 0.5
selector = amsel-adaptive
exploration_priority = amsel-diverse
exploration_duplicate_family_penalty = 0.1
exploration_min_guidance = 1e-12
max_expansions = 16
max_closed_states = 100
max_absorbing_refinements = 4
frontier_committor_tol = 0.1
